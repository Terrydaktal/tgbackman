[Unit]
Description=tgbackman incremental Telegram backup

[Service]
Type=oneshot
TimeoutStartSec=infinity
WorkingDirectory=%h/Dev/tgbackman
# Generate a user-specific unit with:
#   .venv/bin/python telegram_incremental_backup.py install-systemd \
#       --db /path/to/telegram_backup.db \
#       --output "/path/to/Telegram Backup/Telegram API Incremental" \
#       --mount-point /path/to/mount
# The generated ExecStart will include your actual interpreter and paths.
